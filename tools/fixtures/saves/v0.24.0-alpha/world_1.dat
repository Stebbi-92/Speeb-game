"quests": {
"next": 1,
"offers": {
"cinderwick": [{
"at": "cinderwick",
"giver": "tobin",
"have": 0,
"id": "",
"kind": "scout",
"pitch": "No one has come back from Salt Steps in a month. Go and look upon it. Tell me if anyone is left.",
"reward": {
"items": [["salve", 1]],
"rep": 1,
"salt": 59
},
"rid": "r38",
"stage": 0,
"state": "offered",
"steps": [{
"ruin": "r38",
"t": "reach",
"text": "Go and look upon Salt Steps."
}, {
"ask": "I have been to Salt Steps.",
"say": "And? No. Do not tell me. I can see it in your face. Here, for your trouble.",
"t": "talk",
"text": "Return to Tobin at Cinderwick.",
"who": "tobin"
}],
"title": "A Look at Salt Steps"
}, {
"at": "cinderwick",
"giver": "wren",
"hands": [["letter", 1]],
"have": 0,
"id": "",
"kind": "deliver",
"pitch": "This must reach Halvard Grim at Hearthholm. I cannot leave the camp, and there is no one else I trust on the road.",
"reward": {
"items": [["oil", 1], ["bandage", 2]],
"rep": 1,
"salt": 256
},
"stage": 0,
"state": "offered",
"steps": [{
"ask": "Wren sent this, from Cinderwick.",
"item": "letter",
"say": "From Wren? I had thought them dead. Thank you for carrying it. Take this for the road.",
"t": "deliver",
"take": ["letter", 1],
"text": "Carry the sealed letter to Halvard Grim at Hearthholm.",
"who": "halvard"
}],
"title": "Carried to Hearthholm"
}, {
"at": "cinderwick",
"giver": "wren",
"have": 0,
"id": "",
"kind": "scout",
"pitch": "No one has come back from Far Gray Cairn in a month. Go and look upon it. Tell me if anyone is left.",
"reward": {
"items": [["scrap", 4]],
"rep": 1,
"salt": 72
},
"rid": "r160",
"stage": 0,
"state": "offered",
"steps": [{
"ruin": "r160",
"t": "reach",
"text": "Go and look upon Far Gray Cairn."
}, {
"ask": "I have been to Far Gray Cairn.",
"say": "And? No. Do not tell me. I can see it in your face. Here, for your trouble.",
"t": "talk",
"text": "Return to Wren at Cinderwick.",
"who": "wren"
}],
"title": "A Look at Far Gray Cairn"
}, {
"at": "cinderwick",
"giver": "tobin",
"have": 0,
"id": "story_wagon",
"pitch": "There is a wagon down in the gully <dir:R:tobin_wagon:cinderwick> of here. I knew the driver. Will you go and look?",
"reward": {
"items": [["hatchet", 1]],
"rep": 2,
"salt": 40
},
"stage": 0,
"state": "offered",
"steps": [{
"ruin": "tobin_wagon",
"t": "reach",
"text": "Find the wagon in the gully, <dir:R:tobin_wagon:cinderwick> of Cinderwick."
}, {
"crate": "tobin_wagon_0",
"item": "keepsake",
"t": "recover",
"text": "Search the wagon for anything of the driver's."
}, {
"ask": "I found these in the wagon. Prayer beads.",
"say": "Hers. She counted them every night on the road. Forty-one beads, one for every year she drove.

I will put them with the salt. It keeps things. Thank you. Here, take this. It was hers too, and she would want it used.",
"t": "talk",
"take": ["keepsake", 1],
"text": "Bring what you found to Tobin.",
"who": "tobin"
}],
"story": "wagon",
"title": "The Gully Wagon"
}, {
"at": "cinderwick",
"giver": "wren",
"have": 0,
"id": "story_caravans",
"pitch": "The caravans <dir:R:salt_caravans:cinderwick> of the camp died in one night. Forms roost in the wagons now. They come down at dusk and test our wall.",
"reward": {
"items": [["shells", 40], ["bandage", 2]],
"rep": 2,
"salt": 30
},
"stage": 0,
"state": "offered",
"steps": [{
"n": 10,
"ruin": "salt_caravans",
"t": "kill",
"text": "Kill the enemies roosting in the Salt-Pan Caravans, <dir:R:salt_caravans:cinderwick> of Cinderwick."
}, {
"ask": "The caravans are clear.",
"say": "Good. I will not thank you; we are past that. Take these. You will need them more than I will, tonight.",
"t": "talk",
"text": "Tell Wren it is done.",
"who": "wren"
}],
"story": "caravans",
"title": "The Salt-Pan Caravans"
}],
"emberhollow": [{
"at": "emberhollow",
"giver": "pell",
"hands": [["goods", 1]],
"have": 0,
"id": "",
"kind": "deliver",
"pitch": "This must reach Asha Redwater at The Hanging Town. I cannot leave the camp, and there is no one else I trust on the road.",
"reward": {
"items": [["scrap", 4]],
"rep": 1,
"salt": 222
},
"stage": 0,
"state": "offered",
"steps": [{
"ask": "Pell sent this, from Ember Hollow.",
"item": "goods",
"say": "From Pell? I had thought them dead. Thank you for carrying it. Take this for the road.",
"t": "deliver",
"take": ["goods", 1],
"text": "Carry the bundle of goods to Asha Redwater at The Hanging Town.",
"who": "asha"
}],
"title": "Carried to The Hanging Town"
}, {
"at": "emberhollow",
"giver": "gorm",
"have": 0,
"id": "",
"kind": "watch",
"pitch": "Stand the wall with us tonight. We are too few. Undo 8 of the forms that come for Ember Hollow, and see us to the dawn.",
"reward": {
"items": [["coin", 2]],
"rep": 1,
"salt": 54
},
"stage": 0,
"state": "offered",
"steps": [{
"at": "emberhollow",
"n": 8,
"t": "watch",
"text": "Keep Ember Hollow through the night: kill 8 enemies within sight of it."
}, {
"ask": "We kept the wall.",
"say": "We did. I have not slept so well in a month as I did after the dawn. Take this.",
"t": "talk",
"text": "Return to Gorm at Ember Hollow.",
"who": "gorm"
}],
"title": "The Wall of Ember Hollow"
}, {
"at": "emberhollow",
"giver": "gorm",
"have": 0,
"id": "",
"kind": "recover",
"pitch": "We left my father's knife behind at Silent Rise, the night we ran. It is foolish to want it. I want it.",
"reward": {
"items": [["meat", 3]],
"rep": 1,
"salt": 35
},
"stage": 0,
"state": "offered",
"steps": [{
"crate": "r189_0",
"item": "keepsake",
"t": "recover",
"text": "Search Silent Rise for my father's knife."
}, {
"ask": "I found it. My Father's Knife.",
"say": "You found it. I did not think anyone would go. Here, take this, and my thanks.",
"t": "talk",
"take": ["keepsake", 1],
"text": "Return to Gorm at Ember Hollow.",
"who": "gorm"
}],
"title": "Something Left at Silent Rise"
}, {
"at": "emberhollow",
"giver": "gorm",
"have": 0,
"id": "story_coal",
"pitch": "My grandfather's coal ship went down off Cogwright. There was a chart aboard showing where the good seam was. With it I could keep these fires lit for a generation.",
"reward": {
"items": [["coin", 3], ["torchwood", 4]],
"rep": 3,
"salt": 90
},
"stage": 0,
"state": "offered",
"steps": [{
"crate": "wreck_cog_0",
"item": "coal_chart",
"t": "recover",
"text": "Search the wreck off Cogwright, <dir:R:wreck_cog_0:emberhollow> across the sea, for the coal chart."
}, {
"ask": "The chart. Coal, it says, here.",
"say": "On Cogwright itself. So that is what fed the engines.

I will send men when the sea is calm. You have done the hollow a great service, and it will not forget.",
"t": "talk",
"take": ["coal_chart", 1],
"text": "Bring the chart to Gorm at Emberhollow.",
"who": "gorm"
}],
"story": "coal",
"title": "The Coal Ship"
}],
