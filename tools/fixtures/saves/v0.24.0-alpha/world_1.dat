}, {
"ask": "The nest at Weeping Ridge is burned.",
"say": "Then we will sleep tonight, some of us. Thank you.",
"t": "talk",
"text": "Return to Lena at Gallowmere.",
"who": "ash_lena"
}],
"title": "A Nest at Weeping Ridge"
}, {
