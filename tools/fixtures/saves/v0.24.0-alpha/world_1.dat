"title": "Finding Jory"
}, {
"at": "saltreach",
"giver": "tamsin",
"have": 0,
"id": "story_moss",
"pitch": "A wound that will not close is closing too many of my patients. There is a moss on the Sunk Fen, <dir:R:wreck_fen_0:saltreach> across the sea. The old books swear by it.",
"reward": {
"items": [["salve", 3], ["bandage", 3]],
"rep": 2,
"salt": 50
},
"stage": 0,
"state": "offered",
"steps": [{
"crate": "wreck_fen_0",
"item": "fen_moss",
"t": "recover",
"text": "Search the wreck on the Sunk Fen's shore, <dir:R:wreck_fen_0:saltreach> across the sea, where the moss grows thick."
}, {
"ask": "Fen moss, damp still.",
"say": "That is it. Grey-green, and it smells of nothing at all.

I can make a dressing of it that holds better than anything we have. Take some. And if you ever see more of it, bring it.",
"t": "talk",
"take": ["fen_moss", 1],
"text": "Bring the moss to Tamsin at Saltreach.",
"who": "tamsin"
}],
"story": "moss",
"title": "The Fen Cure"
}],
"stillwater": [{
