"salt": 60
},
"stage": 0,
"state": "offered",
"steps": [{
"at": "stillwater",
"n": 10,
"t": "watch",
"text": "Keep Stillwater through the night: kill 10 enemies within sight of it."
}, {
"ask": "We kept the wall.",
"say": "We did. I have not slept so well in a month as I did after the dawn. Take this.",
"t": "talk",
"text": "Return to Kestrel at Stillwater.",
"who": "kestrel"
}],
"title": "The Wall of Stillwater"
}, {
"at": "stillwater",
"giver": "ileana",
"have": 0,
"id": "",
"kind": "find",
"pitch": "My husband, Edda, went to Grey Post to scavenge and has not come back. Please. Find them.",
"reward": {
